# Sin LLM_MODEL: se usa Claude si CLAUDE_API_KEY está disponible; con solo GROQ_API_KEY, se usa Groq.
CLAUDE_API_KEY=
GROQ_API_KEY=

# Opcionales (defaults en el notebook)
# LLM_MODEL=anthropic:claude-sonnet-5-5
# EMBEDDING_MODEL=BAAI/bge-m3
# Acelera la descarga del modelo de embeddings
# HF_TOKEN=

# Para kagglehub: https://www.kaggle.com/settings -> API
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Transcripciones de TED (~48k chunks): por defecto se indexan solo si hay GPU. 1 las fuerza (horas en CPU), 0 las saltea
# INDEX_TRANSCRIPTS=1
